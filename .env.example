# ==============================================================================
# Environment Configuration for GitHub Radar (Part 1: Daily Digest)
# Copy this file to .env and configure your credentials.
# DO NOT commit .env to version control!
# ==============================================================================

# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Your Personal Telegram Chat ID (where daily digests are delivered)
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# OpenRouter API Key (powers primary and fallback LLM)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# GitHub Personal Access Token (for fetching repositories & READMEs without strict rate limits)
GITHUB_API_TOKEN=your_github_pat_token_here

# NVIDIA NIM / Build API Key (optional - used for emergency cold standby model)
NVIDIA_API_KEY=your_nvidia_api_key_here
